# All installs go through Workday Artifactory (npm virtual).
# Keep credentials in your user ~/.npmrc (do not commit tokens), e.g.:
#   npm login --registry=https://artifactory.workday.com/artifactory/api/npm/npm-virtual/
# which writes:
#   //artifactory.workday.com/artifactory/api/npm/npm-virtual/:_authToken=…
registry=https://artifactory.workday.com/artifactory/api/npm/npm-virtual/
